PORT=4000

# --- AWS RDS (IAM auth)
DB_AUTH=iam
RDSHOST=database-1-instance-1.c3eyk6cayb17.ap-northeast-1.rds.amazonaws.com
RDSPORT=5432
RDSUSER=postgres
RDSDATABASE=postgres
AWS_REGION=ap-northeast-1
DB_SSL=require

# Optional local/password fallback (used only when RDSHOST is unset or DB_AUTH=password)
# DATABASE_URL=postgresql://user:password@localhost:5432/dbname

JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=1d
CORS_ORIGIN=http://localhost:3000

# --- Grok / xAI (rule generation) — https://console.x.ai/
GROK_API_KEY=
GROK_BASE_URL=https://api.x.ai/v1
GROK_MODEL=grok-2-latest
GROK_MAX_TOKENS=4096
GROK_TEMPERATURE=0.3

# Free-tier alternative (Groq — different product, often confused with Grok):
# GROK_API_KEY=<key from https://console.groq.com/>
# GROK_BASE_URL=https://api.groq.com/openai/v1
# GROK_MODEL=llama-3.3-70b-versatile

UPLOAD_MAX_BYTES=5242880
